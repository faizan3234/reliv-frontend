# Reliv Customer HTTPS Site — Environment Configuration
# Customer Site Public HTTPS Domain
VITE_CUSTOMER_SITE_URL=https://customer.reliv.in

# Payment Bridge HTTPS Domain (Handles Razorpay Order Creation & RSA Verification)
VITE_PAYMENT_BRIDGE_URL=https://bridge.reliv.in

# Razorpay Key ID (Browser Safe — Only KEY_ID, NEVER Key Secret)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Local Kiosk IP (For top-level HTML form POST handoffs)
VITE_KIOSK_FALLBACK_URL=http://192.168.50.1

# Kiosk ID Default
VITE_DEFAULT_KIOSK_ID=RELIV-001
