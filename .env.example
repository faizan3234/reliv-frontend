# Frontend Environment Variables
# Copy this file to `.env.local` in the repository root. Restart Vite after changing it.

# Authoritative backend endpoint (the app uses this value directly in src/config/api.js)
VITE_BACKEND_URL=http://80.225.243.51:10000

# Frontend origin allowed by the backend CORS policy
FRONTEND_URL=http://161.118.169.29:4173

# Raspberry Pi Local Backend - For Bluetooth Weight Scale Only
# Replace 192.168.1.100 with your Pi's actual IP address#http://192.168.0.101:5001/api/weight
VITE_PI_WEIGHT_URL=http://192.168.0.105:5001

# Razorpay (from Render backend)
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_here

# MQTT Configuration (browser client)
# Use the provider's WebSocket endpoint (`wss://` in production), not mqtt:// or mqtts://.
VITE_MQTT_BROKER=wss://your-cluster.example.com:8884/mqtt
VITE_MQTT_USERNAME=<your-mqtt-username>
VITE_MQTT_PASSWORD=<your-mqtt-password>

# QR Code Domain - Optional custom/proxy domain for QR codes
# Use a separate Vercel domain for QR codes so the real kiosk domain is not exposed
# so the real app domain is never exposed when users scan the QR code.
# If not set, falls back to the current window.location.origin.
VITE_QR_BASE_URL=https://mail-request-m33c.vercel.app

# Supabase - For leaderboard photos and data
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
