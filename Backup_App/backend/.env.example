# =================================================================
# RELIV BACKEND - Environment Variables Template
# =================================================================
# Copy this file to .env and fill in your actual values

# -----------------------------------------------------------------
# Gmail Configuration (for sending emails)
# -----------------------------------------------------------------
# Create App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password-here

# -----------------------------------------------------------------
# MongoDB Atlas Configuration
# -----------------------------------------------------------------
# Get connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/reliv?retryWrites=true&w=majority

# -----------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
DATA_DIR=./data

# -----------------------------------------------------------------
# Razorpay Payment Gateway
# -----------------------------------------------------------------
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# -----------------------------------------------------------------
# MQTT Broker (HiveMQ Cloud)
# -----------------------------------------------------------------
# Get from: https://console.hivemq.cloud/
MQTT_BROKER_URL=mqtts://your-cluster.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# -----------------------------------------------------------------
# Frontend URL (Optional - for CORS)
# -----------------------------------------------------------------
FRONTEND_URL=https://your-frontend.vercel.app
